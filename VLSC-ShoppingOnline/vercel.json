{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && npm --prefix server install && npm --prefix client-admin install && npm --prefix client-customer install",
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "client-customer/build",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
