            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{studentId}}"]
        }
      },
      "response": []
    },
    {
