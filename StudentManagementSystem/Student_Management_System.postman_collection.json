    {
      "name": "2. Get All Students",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      },
      "response": []
    },
    {
      "name": "3. Get Student By Id",
      "request": {
        "method": "GET",
        "header": [
